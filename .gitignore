# Rust
target/
**/*.rs.bk

# cargo-mobile
.cargo/
/gen

# macOS
.DS_Store

# Nix
.direnv/

# Flutter / Dart build outputs
app/build/
app/.dart_tool/
app/linux/flutter/ephemeral/

# Compiled native libraries (built from Rust, regenerated on build)
**/jniLibs/**/*.so

# flutter_rust_bridge codegen output (NOT source; regenerated by
# `nix run .#codegen`). Both halves are build artifacts, so neither is tracked:
#   - app/lib/rust/               (dart_output in flutter_rust_bridge.yaml)
#   - tagsy-bridge/src/frb_generated.rs  (rust_output there)
# app/lib/ otherwise holds the app's real, tracked Dart sources. Edit the Rust
# API (tagsy-bridge/src/api.rs), never these generated files.
app/lib/rust/
tagsy-bridge/src/frb_generated.rs

# Android / Gradle build outputs
app/android/build/
app/android/.gradle/

# Per-device runtime config, copied in from app/config/<name>.json by the
# flake's run-android apps (via ONISYNC_CONFIG). Build artefact, not source.
app/android/app/src/main/assets/tagsy.json
